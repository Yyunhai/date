page {
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.screens {
  display: flex;
  width: 200%;
  transition: transform 300ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.screens.dragging {
  transition: none;
}

.slide {
  flex: 0 0 50%;
  box-sizing: border-box;
  width: 50%;
}

.swipe-cue {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 34rpx 28rpx 0;
  padding: 26rpx 0;
  border-radius: 999rpx;
  background: rgba(91, 108, 255, 0.07);
  color: #6b78e8;
  font-size: 24rpx;
}

.swipe-cue:active {
  opacity: 0.7;
}

.cue-arrow {
  font-size: 32rpx;
  line-height: 24rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  margin: 20rpx 28rpx 0;
  padding: 40rpx 44rpx 44rpx;
  border-radius: 36rpx;
  background: linear-gradient(140deg, #5b6cff 0%, #7c4dff 58%, #a855f7 100%);
  box-shadow: 0 24rpx 52rpx rgba(91, 108, 255, 0.3);
}

.deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
}

.d1 {
  width: 300rpx;
  height: 300rpx;
  top: -120rpx;
  right: -80rpx;
}

.d2 {
  width: 180rpx;
  height: 180rpx;
  bottom: -80rpx;
  left: 40rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.month {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.hero-main {
  position: relative;
  display: flex;
  align-items: flex-end;
  gap: 28rpx;
  margin-top: 26rpx;
}

.day {
  color: #ffffff;
  font-size: 150rpx;
  line-height: 0.9;
  font-weight: 700;
  letter-spacing: -6rpx;
  font-variant-numeric: tabular-nums;
}

.hero-side {
  display: flex;
  flex-direction: column;
  padding-bottom: 18rpx;
}

.week {
  color: rgba(255, 255, 255, 0.95);
  font-size: 31rpx;
  font-weight: 500;
}

.lead {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

.work-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22rpx 28rpx 0;
  padding: 26rpx 30rpx;
  background: #ffffff;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 28rpx rgba(28, 27, 26, 0.05);
}

.work-row:active {
  opacity: 0.8;
}

.wr-main {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}

.wr-k {
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: #8a8681;
}

.wr-v {
  font-size: 34rpx;
  font-weight: 600;
  color: #b0ada7;
}

.wr-v.on {
  color: #1c1b1a;
}

.wr-go {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(91, 108, 255, 0.09);
  color: #4a58d8;
  font-size: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 40rpx 28rpx;
  padding: 84rpx 40rpx 70rpx;
  border: 2rpx dashed #dcd8d1;
  border-radius: 36rpx;
}

.empty-ring {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 30rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(91, 108, 255, 0.14), rgba(124, 77, 255, 0.14));
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4a4744;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a8a49e;
}

.empty-btn {
  margin-top: 40rpx;
  padding: 0 46rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 28rpx;
  background: linear-gradient(135deg, #5b6cff, #7c4dff);
  box-shadow: 0 12rpx 26rpx rgba(91, 108, 255, 0.3);
}

.empty-btn:active {
  opacity: 0.85;
}

.w-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 32rpx 26rpx;
}

.w-title {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #1c1b1a;
}

.w-anchor {
  font-size: 23rpx;
  color: #a3a09b;
}

.w-blank {
  margin: 0 28rpx;
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #b0ada7;
  background: #ffffff;
  border-radius: 28rpx;
}

.w-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 0 28rpx;
}

.w-card {
  flex: 0 0 calc(50% - 11rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 30rpx 30rpx 26rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(28, 27, 26, 0.05);
}

.w-card.lead {
  background: linear-gradient(140deg, #5b6cff 0%, #7c4dff 100%);
  box-shadow: 0 18rpx 40rpx rgba(91, 108, 255, 0.28);
}

.w-k {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #8a8681;
}

.w-v {
  font-size: 40rpx;
  font-weight: 600;
  color: #1c1b1a;
}

.w-s {
  font-size: 22rpx;
  color: #a3a09b;
}

.w-card.lead .w-k {
  color: rgba(255, 255, 255, 0.78);
}

.w-card.lead .w-v {
  font-size: 42rpx;
  color: #ffffff;
}

.w-card.lead .w-s {
  color: rgba(255, 255, 255, 0.72);
}

.w-tip {
  margin: 30rpx 28rpx 0;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: rgba(91, 108, 255, 0.07);
  color: #6b78e8;
  font-size: 23rpx;
  line-height: 36rpx;
}

.w-split {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 28rpx 4rpx;
}

.w-split-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1b1a;
}

.w-split-sub {
  font-size: 21rpx;
  color: #a8a49e;
}
