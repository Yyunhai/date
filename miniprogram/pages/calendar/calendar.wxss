.page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.panel {
  margin: 20rpx 28rpx 0;
  padding: 26rpx 16rpx 20rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(28, 27, 26, 0.06);
}

.panel-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  height: 60rpx;
}

.mlabel {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #1c1b1a;
}

.arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f4f1;
}

.arrow:active {
  background: #ebe9e5;
}

.chev {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #6b6862;
  border-bottom: 4rpx solid #6b6862;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.chev.right {
  transform: rotate(-135deg);
  margin-left: -6rpx;
}

.today-btn {
  position: absolute;
  right: 12rpx;
  padding: 0 22rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  background: rgba(91, 108, 255, 0.09);
  color: #4a58d8;
  font-size: 23rpx;
}

.today-btn:active {
  background: rgba(91, 108, 255, 0.18);
}

.week-row {
  display: flex;
  margin: 22rpx 0 6rpx;
}

.wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #a8a49e;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 14.2857%;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 6rpx;
}

.nb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
}

.n {
  font-size: 27rpx;
  color: #3a3835;
  font-variant-numeric: tabular-nums;
}

.blank .n {
  color: #d3d0ca;
}

.td .nb {
  border-color: rgba(91, 108, 255, 0.45);
}

.td .n {
  color: #4a58d8;
  font-weight: 600;
}

.sel .nb {
  background: linear-gradient(140deg, #5b6cff, #7c4dff);
  box-shadow: 0 8rpx 18rpx rgba(76, 84, 220, 0.34);
}

.sel .n {
  color: #ffffff;
  font-weight: 600;
}

.dots {
  display: flex;
  align-items: center;
  gap: 5rpx;
  height: 16rpx;
}

.md {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.m-WORK {
  background: #2f6bff;
}

.m-DIARY {
  background: #e8890c;
}

.m-SECRET {
  background: #7c4dff;
}

.sel .md {
  opacity: 0.9;
}

.legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 34rpx;
  margin-top: 14rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f0ec;
}

.lg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: #a8a49e;
}

.day-empty {
  margin: 8rpx 28rpx 0;
  padding: 46rpx 30rpx;
  border: 2rpx dashed #dcd8d1;
  border-radius: 28rpx;
  text-align: center;
  font-size: 25rpx;
  color: #a8a49e;
}
