<view class="bar {{barHidden ? 'hidden' : ''}}">
  <view wx:for="{{items}}" wx:key="page"
        class="item {{active === item.page ? 'on' : ''}}"
        data-page="{{item.page}}" data-url="{{item.url}}" bindtap="onGo">
    <image class="ic" src="{{active === item.page ? item.on : item.off}}" />
    <text class="label">{{item.label}}</text>
  </view>
</view>
