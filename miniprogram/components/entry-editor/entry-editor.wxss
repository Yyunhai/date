.root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
}

.mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(24, 22, 30, 0.45);
  animation: mask-in 0.24s ease both;
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -14rpx 40rpx rgba(28, 27, 26, 0.12);
  animation: sheet-in 0.3s cubic-bezier(0.22, 0.8, 0.28, 1) both;
}

.closing .mask {
  animation: mask-out 0.2s ease both;
}

.closing .sheet {
  animation: sheet-out 0.2s cubic-bezier(0.5, 0, 0.9, 0.4) both;
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes mask-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes sheet-in {
  from { transform: translateY(102%); }
  to { transform: translateY(0); }
}

@keyframes sheet-out {
  from { transform: translateY(0); }
  to { transform: translateY(102%); }
}

.grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e2e0dc;
  margin: 0 auto 20rpx;
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #1c1b1a;
}

.date {
  font-size: 24rpx;
  color: #a3a09b;
}

.cats {
  display: flex;
  margin-top: 28rpx;
  padding: 6rpx;
  background: #f1f0ed;
  border-radius: 999rpx;
}

.cat {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #8a8681;
  transition: color 0.2s ease;
}

.cat.on {
  background: #ffffff;
  font-weight: 600;
  color: #1c1b1a;
  box-shadow: 0 6rpx 16rpx rgba(28, 27, 26, 0.08);
}

.c-WORK.on {
  color: #2f6bff;
}

.c-DIARY.on {
  color: #e8890c;
}

.input {
  width: 100%;
  height: 300rpx;
  margin-top: 30rpx;
  padding: 26rpx 28rpx;
  background: #f8f7f5;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 46rpx;
  color: #2b2a27;
}

.ph {
  color: #bdbab4;
}

.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  min-height: 34rpx;
}

.count {
  font-size: 22rpx;
  color: #c3c0ba;
}

.actions {
  display: flex;
  gap: 22rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 94rpx;
  line-height: 94rpx;
  text-align: center;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn.ghost {
  flex: 0 0 200rpx;
  background: #f3f2ef;
  color: #6b6862;
}

.btn.ghost:active {
  background: #e9e7e3;
  color: #d9483b;
}

.btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #5b6cff 0%, #7c4dff 100%);
  box-shadow: 0 12rpx 28rpx rgba(91, 108, 255, 0.32);
}

.btn.primary:active {
  opacity: 0.86;
}

.btn.busy {
  opacity: 0.6;
  box-shadow: none;
}
