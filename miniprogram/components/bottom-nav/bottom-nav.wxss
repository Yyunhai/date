.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: calc(118rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.94);
  border-top: 1rpx solid rgba(28, 27, 26, 0.06);
  backdrop-filter: blur(24rpx) saturate(1.5);
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.ic {
  width: 44rpx;
  height: 44rpx;
}

.label {
  font-size: 21rpx;
  color: #a3a09b;
  letter-spacing: 1rpx;
}

.on .label {
  color: #4a58d8;
  font-weight: 600;
}
