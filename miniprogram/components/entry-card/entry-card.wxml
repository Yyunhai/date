<view class="card cat-{{entry.category}}" bindtap="onTap">
  <view class="rail"></view>

  <view class="main">
    <view class="top">
      <text class="chip">{{entry.categoryLabel}}</text>
      <text class="time">{{time}}</text>
    </view>

    <view class="content {{expanded || !clipped ? 'full' : 'clamp'}}">{{entry.content}}</view>

    <view class="foot" wx:if="{{clipped}}">
      <text class="link" catchtap="onToggleExpand">{{expanded ? '收起' : '展开全文'}}</text>
    </view>
  </view>
</view>
